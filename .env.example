# VaultScope Storefront - Environment Variables

# API Configuration
# The base URL for the VaultScope API (VAMOS)
VITE_API_URL=http://localhost:3000/api

# Authentication Configuration (Authentik OIDC)
# The Authentik instance URL for SSO authentication
VITE_AUTHENTIK_URL=https://auth.vaultscope.de

# The OIDC client ID registered in Authentik for the storefront
VITE_OIDC_CLIENT_ID=vaultscope-storefront

# The OAuth2 callback URL (must match Authentik configuration)
VITE_OIDC_REDIRECT_URI=http://localhost:5174/auth/callback

# Newsletter Integration (Optional - Listmonk)
# Leave blank to disable newsletter signup feature
# VITE_LISTMONK_URL=https://newsletter.vaultscope.de
# VITE_LISTMONK_LIST_UUID=your-list-uuid-here
