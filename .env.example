# ─── VaultScope website — environment variables ───────────────────────────────
# Copy to .env.local for local development.
# In production these are set as Coolify / deployment environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Listmonk waitlist integration ─────────────────────────────────────────────
# URL of the Listmonk instance (no trailing slash).
VITE_LISTMONK_URL=https://subscribe.vaultscope.de

# UUID of the "VaultScope Launch Waitlist" list inside Listmonk.
# Find it under Lists → (list name) → Settings in the Listmonk admin UI.
VITE_LISTMONK_LIST_UUID=
