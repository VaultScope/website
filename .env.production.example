# VaultScope Production Environment Configuration
# Copy to .env.production and fill in actual values
# Never commit .env.production to version control!

# =============================================================================
# Container Registry
# =============================================================================
REGISTRY=ghcr.io/yourorg
VERSION=1.0.0

# =============================================================================
# Service Ports
# =============================================================================
API_PORT=8000
STOREFRONT_PORT=3000
ADMIN_PORT=3001

# =============================================================================
# Database (Managed PostgreSQL - AWS RDS, Azure Database, etc.)
# =============================================================================
DATABASE_URL=postgres://username:password@production-db.region.rds.amazonaws.com:5432/vaultscope
DB_MAX_CONNECTIONS=20

# =============================================================================
# Redis (Managed Redis - AWS ElastiCache, Azure Cache, etc.)
# =============================================================================
REDIS_URL=redis://production-redis.region.cache.amazonaws.com:6379

# =============================================================================
# Security Secrets (from AWS Secrets Manager, Azure Key Vault, etc.)
# =============================================================================
# Generate JWT_SECRET with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_64_BYTE_BASE64_STRING_FROM_SECRETS_MANAGER

# Generate ENCRYPTION_KEY with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_64_CHARACTER_HEX_STRING_FROM_SECRETS_MANAGER

# =============================================================================
# Production Mode & Native Auth
# =============================================================================
DEV_MODE=false

# =============================================================================
# Provisioning Connectors (Environment-based credentials)
# =============================================================================
# Hetzner Cloud API Token for Cloud VPS provisioning & rescue mode
HETZNER_API_TOKEN=your_hetzner_api_token_here

# ReliableSite API for Bare-Metal Dedicated Servers & IPMI controls
RELIABLESITE_API_KEY=your_reliablesite_api_key_here
RELIABLESITE_API_URL=https://api.reliablesite.net/v1

# SFTPGo Storage Provisioner Endpoint & Admin Credentials
SFTPGO_URL=http://sftpgo:8080
SFTPGO_USER=admin
SFTPGO_PASS=CHANGE_ME_SFTPGO_STRONG_PASSWORD

# =============================================================================
# Stripe Payments & Webhooks
# =============================================================================
STRIPE_SECRET_KEY=sk_live_CHANGE_ME_STRIPE_LIVE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_STRIPE_WEBHOOK_SIGNING_SECRET

# =============================================================================
# Transactional Email (SMTP - GoBD Invoice delivery, ticket notices)
# =============================================================================
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USERNAME=support@vaultscope.de
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=support@vaultscope.de

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=https://vaultscope.de,https://admin.vaultscope.de

# =============================================================================
# Job Processing
# =============================================================================
JOB_POLL_INTERVAL_SECS=5

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
RUST_LOG=info

# =============================================================================
# Frontend Build Arguments (baked in at build time)
# =============================================================================
VITE_API_URL=https://api.vaultscope.de/api

# =============================================================================
# Infrastructure Notes
# =============================================================================
# 1. Database: Use managed PostgreSQL (AWS RDS, Azure Database for PostgreSQL)
#    - Version: PostgreSQL 16+
#    - Backup: Automated daily backups with 7-day retention
#    - SSL: Enabled and enforced
#    - Connection pooling: Managed by application (sqlx)
#
# 2. Redis: Use managed Redis (AWS ElastiCache, Azure Cache for Redis)
#    - Version: Redis 7+
#    - Persistence: RDB + AOF for durability
#    - Cluster: Not required (single node sufficient for OIDC state)
#    - Memory: 512MB minimum
#
# 3. Authentik: Deploy separately or use managed service
#    - See https://goauthentik.io/docs/installation/
#    - Configure redirect URIs in provider settings
#    - Enable API access for user registration
#
# 4. SSL/TLS: Use reverse proxy (Nginx, Traefik, AWS ALB)
#    - Terminate SSL at load balancer
#    - Use Let's Encrypt for certificates
#    - Force HTTPS redirect
#
# 5. Secrets Management: Use cloud provider secrets manager
#    - AWS: AWS Secrets Manager
#    - Azure: Azure Key Vault
#    - GCP: Google Secret Manager
#    - Rotate secrets regularly (90 days)
#
# 6. Monitoring: Set up monitoring stack
#    - Logs: CloudWatch, Azure Monitor, or ELK stack
#    - Metrics: Prometheus + Grafana
#    - Alerts: PagerDuty, OpsGenie, or cloud native
#
# 7. Backups: Automated backup strategy
#    - Database: Daily automated backups
#    - Media files: S3/Azure Blob Storage
#    - Disaster recovery: Test restore procedure monthly
