# ─── Listmonk environment variables ──────────────────────────────────────────
# Copy this file to .env and fill in all values before running docker compose.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Strong random password for the internal PostgreSQL instance.
DB_PASSWORD=

# ── Listmonk admin credentials ────────────────────────────────────────────────
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=

# ── SMTP relay ────────────────────────────────────────────────────────────────
# Listmonk uses this to send subscription confirmation emails.
#
# Option A — Resend (recommended, 3 000 emails/month free)
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_AUTH_PROTOCOL=login
#   SMTP_USERNAME=resend
#   SMTP_PASSWORD=<your Resend API key>
#   SMTP_TLS_TYPE=tls
#
# Option B — Brevo (300 emails/day free)
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_AUTH_PROTOCOL=login
#   SMTP_USERNAME=<your Brevo login email>
#   SMTP_PASSWORD=<your Brevo SMTP key>
#   SMTP_TLS_TYPE=starttls
#
# Option C — Generic SMTP (any provider)
#   Fill in the values for your relay below.

SMTP_HOST=
SMTP_PORT=465
SMTP_AUTH_PROTOCOL=login
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_TYPE=tls

# ── From address ──────────────────────────────────────────────────────────────
# Shown as the sender in confirmation emails.
FROM_EMAIL=noreply@vaultscope.de
